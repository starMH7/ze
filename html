
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Partage sécurisé</title>

<style>
:root {
  font-family: Arial, sans-serif;
  color: #182235;
  background: #f3f6fb;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  padding: 20px;
}
main {
  max-width: 850px;
  margin: 30px auto;
}
header, section {
  background: white;
  border: 1px solid #e0e6ef;
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 18px;
}
h1 { color: #2459d3; }
h2 { font-size: 19px; }
p { line-height: 1.6; color: #5a6576; }
.item {
  border: 1px solid #e0e6ef;
  border-radius: 12px;
  padding: 16px;
  margin: 12px 0;
}
.item h3 { margin-top: 0; }
button, .file-label {
  display: inline-block;
  padding: 11px 15px;
  border-radius: 8px;
  border: 0;
  cursor: pointer;
  font-weight: bold;
  font-size: 14px;
  background: #2459d3;
  color: white;
  margin: 5px 3px 5px 0;
}
.secondary {
  color: #182235;
  background: #edf1f7;
}
input, select {
  padding: 10px;
  border: 1px solid #cbd4e2;
  border-radius: 7px;
  max-width: 100%;
}
.field {
  display: grid;
  gap: 6px;
  margin: 12px 0;
}
.field input { width: 100%; }
.output {
  background: #f3f6fb;
  padding: 12px;
  border-radius: 8px;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
#dashboard { display: none; }
video { width: 100%; max-width: 420px; border-radius: 10px; }
.notice {
  border-left: 4px solid #2459d3;
  padding: 12px;
  background: #edf3ff;
}
</style>
</head>

<body>
<main>
<header>
  <h1>Centre de partage des données</h1>
  <p>
    Choisissez les informations que vous souhaitez partager.
    Rien ne sera envoyé à un serveur de collecte par ce code.
    Les informations affichées restent dans cette page,
    sauf la requête IP adressée au service tiers indiqué.
  </p>
  <p class="notice">
    Chaque autorisation est limitée à la fonctionnalité choisie.
    Vous pouvez refuser ou arrêter le partage à tout moment.
  </p>
  <button onclick="ouvrir()">Accepter et continuer</button>
  <button class="secondary" onclick="refuser()">Refuser</button>
</header>

<div id="dashboard">

<section>
<h2>1. Adresse IP publique</h2>
<p>Une requête vers ipify est effectuée seulement après acceptation.</p>
<button onclick="obtenirIP()">Afficher mon IP</button>
<div class="output" id="ip">Non demandée</div>
</section>

<section>
<h2>2. Informations de l'appareil</h2>
<button onclick="infosAppareil()">Afficher mes informations</button>
<div class="output" id="appareil">Non affichées</div>
</section>

<section>
<h2>3. Localisation GPS</h2>
<p>Le navigateur vous demandera séparément votre autorisation.</p>
<button onclick="obtenirPosition()">Partager ma localisation</button>
<div class="output" id="gps">Non demandée</div>
</section>

<section>
<h2>4. Caméra et microphone</h2>
<p>
L'accès est demandé uniquement après votre clic.
La caméra et le microphone ne sont pas enregistrés ni transmis.
</p>
<button onclick="ouvrirMedia()">Autoriser caméra et microphone</button>
<button class="secondary" onclick="arreterMedia()">Arrêter</button>
<video id="video" autoplay playsinline hidden></video>
<div class="output" id="mediaEtat">Désactivés</div>
</section>

<section>
<h2>5. Nom, prénom et e-mail</h2>
<p>Remplissez uniquement les informations que vous souhaitez partager.</p>
<div class="field">
<label for="prenom">Prénom</label>
<input id="prenom" autocomplete="given-name">
</div>
<div class="field">
<label for="nom">Nom</label>
<input id="nom" autocomplete="family-name">
</div>
<div class="field">
<label for="email">E-mail</label>
<input id="email" type="email" autocomplete="email">
</div>
<button onclick="afficherIdentite()">Afficher mon formulaire</button>
<div class="output" id="identite">Aucune donnée renseignée</div>
</section>

<section>
<h2>6. Photos et fichiers</h2>
<p>Sélectionnez vous-même les fichiers que vous souhaitez consulter.</p>
<input type="file" id="fichiers" multiple>
<div class="output" id="fichiersInfo">Aucun fichier sélectionné</div>
<div id="apercus"></div>
</section>

<section>
<h2>7. Contacts et calendrier</h2>
<p>
La disponibilité dépend du navigateur et de l'appareil.
Si votre appareil ne prend pas en charge ces fonctions,
vous pouvez sélectionner un fichier de contacts ou de calendrier.
</p>
<button onclick="choisirContacts()">Choisir des contacts compatibles</button>
<button class="secondary" onclick="choisirCalendrier()">Choisir un fichier calendrier</button>
<input type="file" id="fichierCalendrier"
accept=".ics,text/calendar" hidden>
<div class="output" id="contactsInfo">Aucune donnée sélectionnée</div>
<div class="output" id="calendrierInfo">Aucun fichier sélectionné</div>
</section>

<section>
<h2>8. Messages privés et mots de passe</h2>
<p>
Un site ordinaire ne peut pas lire tous vos messages ou mots de passe.
Ne saisissez pas vos mots de passe ici. Pour partager un document,
choisissez-le explicitement dans la section des fichiers.
</p>
</section>

<section>
<h2>Retirer mon consentement</h2>
<p>
Vous pouvez arrêter la caméra et effacer les informations affichées
dans ce tableau de bord.
</p>
<button class="secondary" onclick="retirer()">Retirer mon consentement</button>
</section>

</div>
</main>

<script>
let consentement = false;
let flux = null;

function ouvrir() {
  consentement = true;
  document.getElementById("dashboard").style.display = "block";
  document.getElementById("dashboard").scrollIntoView({
    behavior: "smooth"
  });
}

function refuser() {
  consentement = false;
  arreterMedia();
  document.getElementById("dashboard").style.display = "none";
  alert("Votre choix a été respecté. Aucune donnée n'a été demandée.");
}

async function obtenirIP() {
  if (!consentement) return;
  const sortie = document.getElementById("ip");
  sortie.textContent = "Chargement...";
  try {
    const reponse = await fetch("https://api.ipify.org?format=json");
    if (!reponse.ok) throw new Error();
    const data = await reponse.json();
    sortie.textContent = consentement ? data.ip : "Demande annulée";
  } catch {
    sortie.textContent = "IP indisponible ou connexion impossible.";
  }
}

function infosAppareil() {
  if (!consentement) return;
  document.getElementById("appareil").textContent =
    "Navigateur : " + navigator.userAgent +
    "\nLangue : " + navigator.language +
    "\nPlateforme déclarée : " + (navigator.platform || "non disponible") +
    "\nTaille de la fenêtre : " +
    window.innerWidth + " x " + window.innerHeight;
}

function obtenirPosition() {
  if (!consentement) return;
  const sortie = document.getElementById("gps");
  if (!navigator.geolocation) {
    sortie.textContent = "Géolocalisation non prise en charge.";
    return;
  }
  sortie.textContent = "En attente de l'autorisation du navigateur...";
  navigator.geolocation.getCurrentPosition(
    pos => {
      if (!consentement) return;
      sortie.textContent =
        "Latitude : " + pos.coords.latitude +
        "\nLongitude : " + pos.coords.longitude +
        "\nPrécision estimée : " + Math.round(pos.coords.accuracy) + " m";
    },
    err => {
      sortie.textContent = err.code === 1
        ? "Autorisation refusée."
        : "Position indisponible.";
    },
    { timeout: 15000, maximumAge: 0 }
  );
}

async function ouvrirMedia() {
  if (!consentement) return;
  if (!navigator.mediaDevices ||
      !navigator.mediaDevices.getUserMedia) {
    document.getElementById("mediaEtat").textContent =
      "Fonction indisponible. Utilisez HTTPS ou localhost.";
    return;
  }
  try {
    flux = await navigator.mediaDevices.getUserMedia({
      video: true,
      audio: true
    });
    if (!consentement) {
      arreterMedia();
      return;
    }
    document.getElementById("video").srcObject = flux;
    document.getElementById("video").hidden = false;
    document.getElementById("mediaEtat").textContent =
      "Caméra et microphone actifs localement.";
  } catch {
    document.getElementById("mediaEtat").textContent =
      "Autorisation refusée ou appareil indisponible.";
  }
}

function arreterMedia() {
  if (flux) {
    flux.getTracks().forEach(track => track.stop());
    flux = null;
  }
  const video = document.getElementById("video");
  video.srcObject = null;
  video.hidden = true;
  document.getElementById("mediaEtat").textContent = "Désactivés";
}

function afficherIdentite() {
  if (!consentement) return;
  const prenom = document.getElementById("prenom").value.trim();
  const nom = document.getElementById("nom").value.trim();
  const email = document.getElementById("email").value.trim();
  document.getElementById("identite").textContent =
    "Prénom : " + (prenom || "non renseigné") +
    "\nNom : " + (nom || "non renseigné") +
    "\nE-mail : " + (email || "non renseigné");
}

document.getElementById("fichiers").addEventListener("change", event => {
  if (!consentement) {
    event.target.value = "";
    return;
  }
  const files = Array.from(event.target.files || []);
  document.getElementById("fichiersInfo").textContent =
    files.length
      ? files.map(f => f.name + " (" + f.size + " octets)").join("\n")
      : "Aucun fichier sélectionné";

  const apercus = document.getElementById("apercus");
  apercus.replaceChildren();

  files.filter(f => f.type.startsWith("image/")).forEach(file => {
    const image = document.createElement("img");
    image.alt = file.name;
    image.style.maxWidth = "150px";
    image.style.margin = "5px";
    image.src = URL.createObjectURL(file);
    apercus.appendChild(image);
  });
});

async function choisirContacts() {
  if (!consentement) return;
  if (!("contacts" in navigator) ||
      !navigator.contacts.select) {
    document.getElementById("contactsInfo").textContent =
      "Sélecteur de contacts non pris en charge. " +
      "Vous pouvez choisir un fichier .vcf dans la section fichiers.";
    return;
  }
  try {
    const contacts = await navigator.contacts.select(
      ["name", "email", "tel"],
      { multiple: true }
    );
    document.getElementById("contactsInfo").textContent =
      JSON.stringify(contacts, null, 2);
  } catch {
    document.getElementById("contactsInfo").textContent =
      "Sélection annulée ou autorisation refusée.";
  }
}

function choisirCalendrier() {
  if (!consentement) return;
  document.getElementById("fichierCalendrier").click();
}

document.getElementById("fichierCalendrier")
.addEventListener("change", async event => {
  if (!consentement) return;
  const file = event.target.files[0];
  if (!file) return;
  const texte = await file.text();
  document.getElementById("calendrierInfo").textContent =
    texte.slice(0, 10000) +
    (texte.length > 10000 ? "\n[Affichage limité]" : "");
});

function retirer() {
  consentement = false;
  arreterMedia();

  document.querySelectorAll("#dashboard .output").forEach(el => {
    el.textContent = "Effacé";
  });

  document.getElementById("prenom").value = "";
  document.getElementById("nom").value = "";
  document.getElementById("email").value = "";
  document.getElementById("fichiers").value = "";
  document.getElementById("fichierCalendrier").value = "";
  document.getElementById("apercus").replaceChildren();
  document.getElementById("dashboard").style.display = "none";
  window.scrollTo({ top: 0, behavior: "smooth" });
}
</script>
</body>
</html>
